extends SceneTree
var failures: Array[String] = []
var checks := 0
func _initialize() -> void:_run.call_deferred()
func check(ok: bool,words: String) -> void:
	checks+=1
	if not ok:failures.append(words);push_error("PACKAGE_CHECK_FAIL "+words)
func frames() -> void:
	for i in 8:await process_frame
func _run() -> void:
	var game := root.get_node("G")
	game.set("SAVE_PATH","res://_package_probe_save.json")
	game.call("_init_state_defaults")
	game.set("save_locked",false)
	game.set("selected_role","zs")
	game.set("gm_world_open",true)
	game.get("wallet")["honor"]=1240
	game.get("prog")["main_world"]={"map_id":"old_salt_road"}
	check(ProjectSettings.get_setting("application/config/version")=="0.2.2-experience","packaged version")
	check(root.get_node("GmConsole").get("_bar_layer")==null,"no default GM overlay")
	var market: Control=load("res://src/ui/HonorMarketPanel.gd").new()
	root.add_child(market)
	await frames()
	check(market.get("_category_buttons").size()==3,"packaged category browser")
	market.call("_set_category","gem")
	await frames()
	check(market.get("_grid").get_child_count()==2,"packaged gem filter")
	check(market.get("_hero")!=null,"packaged shop hero")
	market.queue_free()
	await frames()
	var activities: Control=load("res://src/ui/ActivityPanel.gd").new()
	root.add_child(activities)
	await frames()
	check(activities.get("_events").size()==2,"packaged activity content")
	activities.call("show_event","arena_practice")
	check(activities.get("_detail_id")=="arena_practice","packaged activity detail")
	activities.queue_free()
	await frames()
	var bag: Control=load("res://src/ui/BagPanel.gd").new()
	root.add_child(bag)
	await frames()
	check(bag.get("_scroll").has_method("gesture_active"),"packaged touch scroll")
	bag.queue_free()
	await frames()
	var points: Script=load("res://src/world/WorldPoints.gd")
	var target := "old_salt_road:fish_salt_spring"
	check(not points.call("find",target).is_empty(),"packaged real-coordinate catalog")
	check(bool(points.call("track",target).get("ok",false)),"packaged destination saves")
	check(bool(game.call("reload_save")),"packaged save reload")
	check(points.call("target").get("id","")==target,"packaged destination restore")
	var fishing: Control=load("res://src/ui/FishingPanel.gd").new()
	root.add_child(fishing)
	fishing.call("open_spot","fish_salt_spring")
	await frames()
	check(fishing.get("_water")!=null and fishing.get("_stage_label")!=null,"packaged dedicated fishing scene")
	check(load("res://assets/ui/experience_20261026/fishing_scene.png")!=null,"packaged fishing illustration")
	check(load("res://assets/ui/experience_20261026/market_banner.png")!=null,"packaged shop illustration")
	fishing.call("close")
	await frames()
	var point_map: Control=load("res://src/ui/WorldPointMap.gd").new()
	root.add_child(point_map)
	await frames()
	check(point_map.has_method("_close_picker"),"packaged safe-area cluster chooser")
	if point_map.has_method("_close_picker"):
		var ids: Array=[]
		for row in points.call("rows","lorin_wilds"):
			ids.append(row.id)
			if ids.size()==2:break
		point_map.call("_choose_cluster",ids)
		await frames()
		check(game.call("ui_safe_rect",point_map).encloses(point_map.get("_picker_frame").get_global_rect()),"packaged cluster choices fit screen")
	point_map.queue_free()
	await frames()
	var mounts: Script=load("res://src/world/MountVisual.gd")
	var sprites: SpriteFrames=mounts.call("frames_for","zs","horse")
	check(is_equal_approx(sprites.get_animation_speed("walk_down"),7.0),"packaged slower walk")
	check(is_equal_approx(sprites.get_animation_speed("run_down"),11.5),"packaged slower run")
	var world: Dictionary=load("res://src/combat/TableCache.gd").call("main_world_config")
	for id in world.get("maps",{}):check(is_equal_approx(float(world.maps[id].player_scale),.70),"packaged scale "+id)
	var f := FileAccess.open("res://package_runtime_results.json",FileAccess.WRITE)
	f.store_string(JSON.stringify({"checks":checks,"failures":failures},"\t"))
	f.close()
	print("PACKAGE_EXPERIENCE checks=%d failures=%d"%[checks,failures.size()])
	root.get_node("Audio").call("set_suspended",true)
	await frames()
	quit(0 if failures.is_empty() else 1)
