global:
  scrape_interval: 15s
  evaluation_interval: 15s
rule_files:
  - alerts.yml
scrape_configs:
  - job_name: yuanzheng
    static_configs:
      - targets: ["127.0.0.1:18081"]
    authorization:
      type: Bearer
      credentials_file: /etc/yuanzheng/secrets/admin-token
    scrape_timeout: 3s
