    {"id": "s26", "title": "雪中回讯", "goal": "到驿北霜林栈道观察双关讯号", "event": "observe", "map": "frost_boardwalk", "target": "signal_ribbons", "requires_item": "gate_stamp", "next": "s27", "reward": {"gold": 160, "exp": 110, "item": "frost_reply", "count": 1}},
    {"id": "s27", "title": "雪幕领主", "goal": "进入冰隘，击败雪幕领主", "event": "defeat", "map": "frost_pass", "target": "mon_snowveil_lord", "requires_item": "frost_reply", "next": "s28", "reward": {"gold": 340, "exp": 230, "item": "veil_seal", "count": 1}},
    {"id": "s28", "title": "双关定路", "goal": "回霜关驿找宁砚，决定先恢复哪路供货", "dialogue": "轨道和雪幕都已查清。商货与守关补给只能先放一队，两边的人都等得太久。另一条路随后仍会恢复。", "event": "talk", "map": "frost_post", "target": "npc_frost_envoy", "requires_item": "veil_seal", "craft_options": {"merchant": {"title": "商货先行", "costs": {}}, "wardens": {"title": "守关补给", "costs": {}}}, "next": "s29", "reward": {"gold": 280, "exp": 160}},
    {"id": "s29", "title": "关外回声", "goal": "在霜关驿向宁砚询问关外回声", "dialogue": "雪幕退去后，冰隘东口又响起了碑声。商路、港口、雪关的拓片都指向同一处裂隙。别急着入渊，先沿东侧石路看清它在呼唤谁。", "event": "talk", "map": "frost_post", "target": "npc_frost_envoy", "next": "s30", "reward": {"gold": 180, "exp": 5924}},
