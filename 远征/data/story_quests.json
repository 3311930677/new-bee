    {"id": "s07", "title": "带回线索", "goal": "回边城向闻叔复命", "dialogue": "坡上的守影果然出现了。青姨保存着早年的碑文拓片，你去向她问问。", "event": "talk", "map": "lorin_wilds", "target": "npc_steward", "next": "s08", "reward": {"gold": 90, "exp": 55}},
