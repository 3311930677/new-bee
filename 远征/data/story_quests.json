    {"id": "s15", "title": "断桥盐车", "goal": "在旧盐道断桥盐车取回账页", "event": "collect", "map": "old_salt_road", "target": "salt_cart_ledger", "next": "s16", "reward": {"gold": 90, "exp": 60, "item": "salt_ledger", "count": 1}},
