    {"id": "s31", "title": "三地同声", "goal": "沿外环石路查看共鸣碑座", "event": "observe", "map": "abyss_ring", "target": "breach_resonance", "next": "s32", "reward": {"gold": 190, "exp": 15178, "item": "rift_echo", "count": 1}},
    {"id": "s32", "title": "旧卷新页", "goal": "带渊口回响回昭元，请青姨对照三地拓片", "dialogue": "碑声不是在催我们开门，是在等人听完。三地拓片缺失的名字能拼成一页；走入深处之前，你想先听回声，还是先稳住碑座？两种办法都能留下一条归路。", "event": "talk", "map": "lorin_wilds", "target": "npc_scribe", "requires_item": "rift_echo", "craft_options": {"listen": {"title": "先听回声", "costs": {}}, "brace": {"title": "先稳碑座", "costs": {}}}, "next": "", "reward": {"gold": 260, "exp": 17885, "item": "stele_key", "count": 1}}
