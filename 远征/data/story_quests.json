    {"id": "s01", "title": "城门来信", "goal": "与边城执事闻叔交谈", "dialogue": "北门古道的界碑忽然失了声。先去枫林古道看看，碰上敌影不要硬撑。", "event": "talk", "map": "lorin_wilds", "target": "npc_steward", "next": "s02", "reward": {"gold": 40, "exp": 15}},
