    {"id": "s13", "title": "盐账线索", "goal": "在边城找行脚商人问旧盐道", "dialogue": "有车盐没进边城，却在旧道断桥留下了车辙。账页恐怕还在车上，沿古道东侧去找。", "event": "talk", "map": "lorin_wilds", "target": "npc_warden", "next": "s14", "reward": {"gold": 75, "exp": 45}},
