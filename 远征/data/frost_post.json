      "lines": [
        "东边的车翻了，绞盘却还在转。有人改过旧轨。",
        "我守在这里等伙伴回来。你若见到他们，替我捎句话。"
      ],
      "frost_cloak": true,
      "choice_lines": {
        "merchant": [
